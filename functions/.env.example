# Copy to .env.project-5032assessment (deploy) or .env.local (emulator).
# Neither copy is committed. The SendGrid API key is NOT set here — it is a
# secret:  npx firebase functions:secrets:set SENDGRID_API_KEY
# (for the emulator, put SENDGRID_API_KEY=... in functions/.secret.local)

# The sender address verified in SendGrid (Settings → Sender Authentication).
MAIL_FROM=
# Public address of the web app, used for links in emails.
APP_URL=http://localhost:5173
